[Unit]
Description=SnakeKonginVerse personal website
After=network.target postgresql.service

[Service]
Type=simple
User=snakeverse
Group=snakeverse
WorkingDirectory=/var/www/snakekonginverse
Environment=NODE_ENV=production
EnvironmentFile=/var/www/snakekonginverse/.env
# 按 command -v node 的结果调整路径。
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/snakekonginverse/.next /var/lib/snakekonginverse/media

[Install]
WantedBy=multi-user.target
