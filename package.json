{
  "name": "snakekonginverse",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env scripts/next-runtime.mjs dev",
    "build": "next build",
    "start": "node --env-file=.env scripts/next-runtime.mjs start",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "r2:check": "node --env-file=.env deploy/r2-storage.mjs check",
    "db:migrate": "payload migrate",
    "db:migration": "payload migrate:create",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check:lines": "node scripts/check-lines.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:lines",
    "test:cms": "tsx --env-file=.env scripts/verify-cms.ts",
    "import:novels": "tsx scripts/import-novels.ts",
    "test:novel-views": "tsx --env-file=.env scripts/verify-novel-views.ts",
    "test:novels": "tsx --env-file=.env scripts/verify-novels.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/noto-serif-jp": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-tc": "^5.3.1",
    "@microsoft/clarity": "1.0.2",
    "@next/third-parties": "16.4.5",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "graphql": "^16.14.2",
    "katex": "^0.19.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.4",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "license": "GPL-3.0-only"
}
