{
  "name": "snakekonginverse",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "db:migrate": "payload migrate",
    "db:migration": "payload migrate:create",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check:lines": "node scripts/check-lines.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:lines",
    "test:cms": "tsx --env-file=.env scripts/verify-cms.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "graphql": "16.14.2",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
