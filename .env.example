# 本地配置；生产部署保留服务器自己的数据库、密钥和网站地址。

# ── 运行时 ──
APP_HOST=127.0.0.1
APP_PORT=3000
TEST_BASE_URL=http://127.0.0.1:3000
PAYLOAD_DB_PUSH=false

# ── 数据库 PostgreSQL ──
DATABASE_URL=postgresql://snakekongin:YOUR_PASSWORD@127.0.0.1:5432/snakekonginverse_db

# ── CMS 安全 ──
PAYLOAD_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── 网站地址 ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 媒体存储 Cloudflare R2 ──
# S3 Endpoint 和访问密钥只用于服务端，不要提交真实密钥。
R2_BUCKET=snakekonginverse-media
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── 访问统计（选填，生产环境启用） ──
# Clarity 项目 ID；GA4 数据流衡量 ID（G- 开头）。留空则不加载对应统计。
CLARITY_PROJECT_ID=
GA4_MEASUREMENT_ID=
